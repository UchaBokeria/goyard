package components

import (
	"github.com/UchaBokeria/goyard/examples/simple/app/dto"
	"github.com/UchaBokeria/goyard/pipes"
)

type UserAlpine struct {
    Show bool
    Pwd  string
}


templ User(user *dto.UserCreateDto) {
    <div x-data={pipes.Json(UserAlpine{Show: false, Pwd: user.Password})}
        class="p-4 bg-white text-black rounded-lg shadow-md">
        <h3 class="text-lg font-bold">{user.Email}</h3>
        
        <div class="flex justify-between items-center">
            <p x-text="Show ? Pwd : '********'" class="text-gray-700" />
            <i x-on:click="Show = !Show" class="cursor-pointer">
                <svg x-show="!Show" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg x-show="Show" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </i>
        </div>
    </div>
}
